---
import '@fontsource/doppio-one/400.css';
import '@fontsource/roboto-condensed/400.css';
import '@fontsource/roboto-condensed/700.css';
import '@fontsource/roboto-condensed/900.css';
import '../styles/global.css';
// Polices du texte et des grands titres : préchargées pour éviter le changement de police à l'affichage
import fontBody from '@fontsource/doppio-one/files/doppio-one-latin-400-normal.woff2?url';
import fontTitle from '@fontsource/roboto-condensed/files/roboto-condensed-latin-900-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import Seo, { type ArticleMeta } from '../components/layout/Seo.astro';
import Analytics from '../components/layout/Analytics.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Lightbox from '../components/layout/Lightbox.astro';
import { getSettings } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  article?: ArticleMeta;
  noindex?: boolean;
  /** En-tête transparent posé sur une grande photo */
  overlayHeader?: boolean;
  /** Page avec des photos à agrandir (articles, pages) */
  lightbox?: boolean;
}
const { overlayHeader = false, lightbox = false, ...seo } = Astro.props;
const site = await getSettings();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontTitle} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
    {lightbox && <Lightbox />}
  </body>
</html>

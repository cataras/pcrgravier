---
import Base from '../../layouts/Base.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { PAGE_SIZE, getArticles } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  const last = Math.ceil(articles.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => {
    const n = i + 2;
    return { params: { page: String(n) }, props: { n, last, articles: articles.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE) } };
  });
}
const { n, last, articles } = Astro.props;
---

<Base title={`Page ${n}`}>
  <header class="list-header"><h1>Articles – page {n}</h1></header>
  <ArticleGrid articles={articles} />
  <Pagination current={n} last={last} />
</Base>

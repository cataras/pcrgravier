---
/**
 * Carte de toutes les sorties : le tracé et le point de départ de chaque
 * article qui a une trace RideWithGPS ou des coordonnées dans sa fiche.
 *
 * Carte vectorielle MapLibre, à la manière de RideWithGPS, sans compte ni clé :
 *   - fond clair OpenFreeMap (données OpenStreetMap) ;
 *   - ombrage du relief et courbes de niveau calculés dans le navigateur à
 *     partir des altitudes publiques « Terrain Tiles » d'AWS.
 */
import Base from '../layouts/Base.astro';
import { getArticles, getCategories, mainCategory, thumbnail, url } from '../lib/site';
import { getRide, simplify } from '../lib/rides';

// Une couleur par catégorie, dans l'ordre des catégories
const PALETTE = ['#c2410c', '#2f6f8f', '#6b7b5d', '#8e4585', '#a16207', '#0f766e', '#be123c'];
const categories = (await getCategories()).filter((c) => c.count);
const colorOf = new Map(categories.map((c, i) => [c.entry.id, PALETTE[i % PALETTE.length]]));

const rides = [];
for (const a of await getArticles()) {
  const ride = await getRide(a);
  if (ride?.lat === undefined || ride.lng === undefined) continue;
  const cat = await mainCategory(a);
  const thumb = a.data.cover ? await thumbnail(a.data.cover, 480) : null;
  rides.push({
    title: a.data.title,
    href: url.entry(a.id),
    category: cat?.data.name ?? '',
    color: (cat && colorOf.get(cat.id)) ?? '#0a0a0a',
    thumb,
    distance: ride.distance ?? null,
    elevation: ride.elevation ?? null,
    place: [ride.place, ride.region].filter(Boolean).join(', '),
    lat: ride.lat,
    lng: ride.lng,
    // tracé allégé pour la carte (~80 m de précision, largement suffisant à cette échelle)
    tracks: ride.tracks.map((t) => simplify(t, 0.0008).map(([la, ln]) => [+la.toFixed(4), +ln.toFixed(4)])),
  });
}
const used = new Set(rides.map((r) => r.color));
const legend = categories
  .map((c) => ({ name: c.entry.data.name, color: colorOf.get(c.entry.id)! }))
  .filter((l) => used.has(l.color));
---

<Base title="Carte des sorties" description="Toutes les aventures du collectif PCR Gravier sur une carte">
  <header class="list-header">
    <h1>Carte des sorties</h1>
    <p class="list-intro">{rides.length} aventures, de la porte d'à côté au bout du monde. Clique sur un tracé pour lire le récit.</p>
  </header>
  <div class="map-wrap">
    <div id="map" data-rides={JSON.stringify(rides)} role="region" aria-label="Carte des sorties"></div>
    <ul class="map-legend">
      {legend.map((l) => <li><span style={`background:${l.color}`}></span>{l.name}</li>)}
    </ul>
  </div>
</Base>

<script>
  import type { FeatureCollection } from 'geojson';

  // MapLibre (~270 Ko compressés) n'est téléchargé qu'à l'approche de la carte :
  // le reste de la page s'affiche sans l'attendre.

  type RidePoint = {
    title: string; href: string; category: string; color: string; thumb: string | null;
    distance: number | null; elevation: number | null; place: string;
    lat: number; lng: number; tracks: [number, number][][];
  };

  const el = document.getElementById('map')!;
  const rides: RidePoint[] = JSON.parse(el.dataset.rides!);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const n = (v: number) => v.toLocaleString('fr-FR');

  async function start() {
    const [{ default: maplibregl }, { default: mlcontour }] = await Promise.all([
      import('maplibre-gl'),
      import('maplibre-contour'),
      import('maplibre-gl/dist/maplibre-gl.css'),
    ]);

    // Altitudes publiques (AWS Terrain Tiles) : ombrage + courbes de niveau
    const dem = new mlcontour.DemSource({
      url: 'https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png',
      encoding: 'terrarium',
      maxzoom: 13,
      worker: true,
    });
    dem.setupMaplibre(maplibregl);

    // GeoJSON des tracés et des points de départ ([lat, lng] → [lng, lat])
    const props = (r: RidePoint, i: number) => ({ i, color: r.color, title: r.title });
    const lines = {
      type: 'FeatureCollection',
      features: rides.flatMap((r, i) =>
        r.tracks.filter((t) => t.length > 1).map((t) => ({
          type: 'Feature', properties: props(r, i),
          geometry: { type: 'LineString', coordinates: t.map(([la, ln]) => [ln, la]) },
        })),
      ),
    } as FeatureCollection;
    const starts = {
      type: 'FeatureCollection',
      features: rides.map((r, i) => ({ type: 'Feature', properties: props(r, i), geometry: { type: 'Point', coordinates: [r.lng, r.lat] } })),
    } as FeatureCollection;

    // Vue de départ : le gros des sorties (les voyages lointains restent visibles en dézoomant)
    const median = (xs: number[]) => xs.slice().sort((a, b) => a - b)[Math.floor(xs.length / 2)] ?? 0;
    const c = { lat: median(rides.map((r) => r.lat)), lng: median(rides.map((r) => r.lng)) };
    const near = (r: RidePoint) => Math.hypot(r.lat - c.lat, (r.lng - c.lng) * Math.cos((c.lat * Math.PI) / 180)) < 13.5;
    const bounds = new maplibregl.LngLatBounds();
    for (const r of rides.filter(near)) for (const t of r.tracks) for (const [la, ln] of t) bounds.extend([ln, la]);
    if (bounds.isEmpty()) bounds.extend([2.5, 46.6]);

    const hash = location.hash.match(/^#(-?[\d.]+),(-?[\d.]+)$/);
    const map = new maplibregl.Map({
      container: el,
      style: 'https://tiles.openfreemap.org/styles/positron',
      ...(hash ? { center: [+hash[2], +hash[1]] as [number, number], zoom: 11 } : { bounds, fitBoundsOptions: { padding: 30 } }),
      cooperativeGestures: true, // zoom à deux doigts / Ctrl + molette : la page défile normalement
      maxZoom: 16,
      attributionControl: { compact: true, customAttribution: 'Relief : <a href="https://registry.opendata.aws/terrain-tiles/">Terrain Tiles (AWS, SRTM…)</a>' },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-left');
    map.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-left');
    map.addControl(new maplibregl.FullscreenControl(), 'top-right');

    map.on('load', () => {
      // noms de lieux en français quand OpenStreetMap les connaît
      for (const layer of map.getStyle().layers) {
        if (layer.type === 'symbol' && JSON.stringify(map.getLayoutProperty(layer.id, 'text-field') ?? '').includes('name')) {
          map.setLayoutProperty(layer.id, 'text-field', ['coalesce', ['get', 'name:fr'], ['get', 'name:latin'], ['get', 'name']]);
        }
      }
      // les ombrages et courbes passent sous les routes et les noms de lieux
      const firstRoad = map.getStyle().layers.find((l) => l.id.includes('road') || l.id.includes('highway') || l.type === 'symbol')?.id;

      map.addSource('relief', { type: 'raster-dem', tiles: [dem.sharedDemProtocolUrl], encoding: 'terrarium', tileSize: 256, maxzoom: 13 });
      map.addLayer({
        id: 'relief', type: 'hillshade', source: 'relief',
        paint: {
          'hillshade-exaggeration': ['interpolate', ['linear'], ['zoom'], 4, 0.25, 10, 0.4, 14, 0.3],
          'hillshade-shadow-color': '#5c5f66',
          'hillshade-highlight-color': '#ffffff',
          'hillshade-accent-color': '#6e7178',
        },
      }, firstRoad);

      map.addSource('courbes', {
        type: 'vector',
        tiles: [dem.contourProtocolUrl({
          multiplier: 1,
          thresholds: { 11: [100, 500], 12: [50, 250], 13: [20, 100], 14: [10, 50] },
          elevationKey: 'ele', levelKey: 'level', contourLayer: 'contours',
        })],
        maxzoom: 15,
      });
      map.addLayer({
        id: 'courbes', type: 'line', source: 'courbes', 'source-layer': 'contours', minzoom: 11,
        paint: { 'line-color': '#a08a6e', 'line-opacity': ['match', ['get', 'level'], 1, 0.55, 0.25], 'line-width': ['match', ['get', 'level'], 1, 0.9, 0.5] },
      }, firstRoad);
      map.addLayer({
        id: 'courbes-cotes', type: 'symbol', source: 'courbes', 'source-layer': 'contours', minzoom: 12,
        filter: ['>', ['get', 'level'], 0],
        layout: { 'symbol-placement': 'line', 'text-field': ['concat', ['number-format', ['get', 'ele'], {}], ' m'], 'text-size': 10, 'text-font': ['Noto Sans Regular'] },
        paint: { 'text-color': '#8a7559', 'text-halo-color': '#fff', 'text-halo-width': 1.2 },
      });

      // Tracés : liseré blanc + couleur de la catégorie
      map.addSource('traces', { type: 'geojson', data: lines });
      map.addSource('departs', { type: 'geojson', data: starts });
      map.addLayer({ id: 'traces-lisere', type: 'line', source: 'traces', layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#fff', 'line-width': ['interpolate', ['linear'], ['zoom'], 4, 4, 12, 7], 'line-opacity': 0.85 } });
      map.addLayer({ id: 'traces', type: 'line', source: 'traces', layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': ['get', 'color'], 'line-width': ['interpolate', ['linear'], ['zoom'], 4, 2.2, 12, 4] } });
      map.addLayer({ id: 'traces-survol', type: 'line', source: 'traces', filter: ['==', ['get', 'i'], -1], layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': ['get', 'color'], 'line-width': ['interpolate', ['linear'], ['zoom'], 4, 4, 12, 6.5] } });
      map.addLayer({ id: 'departs', type: 'circle', source: 'departs',
        paint: { 'circle-radius': ['interpolate', ['linear'], ['zoom'], 4, 4.5, 12, 7], 'circle-color': ['get', 'color'], 'circle-stroke-color': '#fff', 'circle-stroke-width': 2 } });

      // Survol et clic : vignette du récit
      const interactive = ['traces', 'departs'];
      const tip = new maplibregl.Popup({ closeButton: false, closeOnClick: false, offset: 10, className: 'map-tip' });
      map.on('mousemove', interactive, (e) => {
        const f = e.features?.[0];
        if (!f) return;
        map.getCanvas().style.cursor = 'pointer';
        map.setFilter('traces-survol', ['==', ['get', 'i'], f.properties.i]);
        tip.setLngLat(e.lngLat).setText(f.properties.title).addTo(map);
      });
      map.on('mouseleave', interactive, () => {
        map.getCanvas().style.cursor = '';
        map.setFilter('traces-survol', ['==', ['get', 'i'], -1]);
        tip.remove();
      });
      map.on('click', interactive, (e) => {
        const r = rides[e.features![0].properties.i];
        tip.remove();
        const stats = [r.distance && `${n(r.distance)} km`, r.elevation && `${n(r.elevation)} m D+`].filter(Boolean).join(' · ');
        new maplibregl.Popup({ maxWidth: '16rem', offset: 8 })
          .setLngLat(e.lngLat)
          .setHTML(`
            <a class="map-card" href="${esc(r.href)}">
              ${r.thumb ? `<img src="${esc(r.thumb)}" alt="" />` : ''}
              <span class="map-card-body">
                ${r.category ? `<span class="map-card-cat" style="color:${r.color}">${esc(r.category)}</span>` : ''}
                <strong>${esc(r.title)}</strong>
                ${stats ? `<span>${stats}</span>` : ''}
                ${r.place ? `<span>${esc(r.place)}</span>` : ''}
              </span>
            </a>`)
          .addTo(map);
      });
    });
  }

  const io = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        start().catch((e) => {
          console.error('[carte]', e);
          el.dataset.error = '';
        });
      }
    },
    { rootMargin: '300px' },
  );
  io.observe(el);
</script>

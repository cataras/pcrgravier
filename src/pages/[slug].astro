---
/**
 * Articles et pages, à la racine du site comme sur l'ancien WordPress
 * (/parpaillon/, /a-propos/…).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, slugify, authorSlug, formatDate } from '../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  const pages = await getCollection('pages');
  return [
    ...articles.map((entry, i) => ({
      params: { slug: entry.id },
      props: { entry, kind: 'article' as const, newer: articles[i - 1], older: articles[i + 1] },
    })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'page' as const } })),
  ];
}

const { entry, kind, newer, older } = Astro.props;
const { Content } = await render(entry);
const data = entry.data as { title: string; cover?: ImageMetadata; date?: Date; author?: string; categories?: string[] };
const category = data.categories?.[0];
---

<Base title={data.title} image={data.cover} overlayHeader>
  <section class:list={['hero', { 'hero-page': kind === 'page' }]}>
    {data.cover && <Image src={data.cover} alt="" layout="full-width" loading="eager" fetchpriority="high" />}
    <div class="hero-content">
      {category && <a class="pill" href={`/category/${slugify(category)}/`}>{category}</a>}
      <h1>{data.title}</h1>
      {kind === 'article' && data.date && (
        <p class="meta">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          {data.author && <> · <a href={`/author/${authorSlug(data.author)}/`}>{data.author}</a></>}
        </p>
      )}
    </div>
  </section>

  <article class="prose">
    <Content />
  </article>

  {kind === 'article' && (newer || older) && (
    <nav class="post-nav" aria-label="Autres articles">
      <h2 class="visually-hidden">Autres articles</h2>
      <div class="grid">
        {older && <ArticleCard article={older} />}
        {newer && <ArticleCard article={newer} />}
      </div>
    </nav>
  )}
</Base>

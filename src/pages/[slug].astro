---
/**
 * Articles et pages, à la racine du site comme sur l'ancien WordPress
 * (/parpaillon/, /a-propos/…).
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryHero from '../components/EntryHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RideSheet from '../components/RideSheet.astro';
import { getArticles, getPages, mainCategory, getAuthor, excerpt, thumbnail, formatDate, url, type Article, type Page } from '../lib/site';
import { getRide } from '../lib/rides';
import { getRelated } from '../lib/related';
import { articleVideos, videoUrls } from '../lib/videos';

type Props = { kind: 'article'; entry: Article; related: Article[] } | { kind: 'page'; entry: Page };

export async function getStaticPaths() {
  const articles = await getArticles();
  return [
    ...(await Promise.all(
      articles.map(async (entry) => ({
        params: { slug: entry.id },
        props: { kind: 'article', entry, related: await getRelated(entry, articles) } satisfies Props,
      })),
    )),
    ...(await getPages()).map((entry) => ({ params: { slug: entry.id }, props: { kind: 'page', entry } satisfies Props })),
  ];
}

const props = Astro.props;
const { entry } = props;
const { title, cover } = entry.data;
const { Content } = await render(entry);
const description = entry.data.description ?? excerpt(entry.body);

const isArticle = props.kind === 'article';
const category = isArticle ? await mainCategory(props.entry) : undefined;
const author = isArticle ? await getAuthor(props.entry) : undefined;
const ride = isArticle ? await getRide(props.entry) : undefined;
const date = isArticle ? props.entry.data.date : undefined;
const related = isArticle ? props.related : [];
// option « Ajouter les vidéos des articles » : sauf celles déjà dans le texte de la page
const videos = !isArticle && props.entry.data.videos ? articleVideos(await getArticles(), videoUrls(entry.body)) : [];
// vignette affichée dans les résultats de la recherche
const searchThumb = cover ? await thumbnail(cover, 320) : undefined;
---

<Base
  title={title}
  description={description}
  image={cover}
  article={date ? { published: date, author: author?.data.name, section: category?.data.name } : undefined}
  overlayHeader
  lightbox
>
  <div data-pagefind-body>
    {searchThumb && <img class="visually-hidden" src={searchThumb} alt="" data-pagefind-meta="image[src]" />}
    <EntryHero id={entry.id} title={title} cover={cover} date={date} author={author} category={category} compact={!isArticle} />

    {ride && <RideSheet ride={ride} />}

    <article class="prose">
      <Content />
      {videos.map(({ html, article }) => (
        <section class="video-item">
          <h2><a href={url.entry(article.id)}>{article.data.title}</a></h2>
          <p class="video-date">{formatDate(article.data.date)} · <a href={url.entry(article.id)}>Lire le récit</a></p>
          <Fragment set:html={html} />
        </section>
      ))}
    </article>
  </div>

  {related.length > 0 && (
    <nav class="post-nav" aria-labelledby="related-title">
      <h2 id="related-title" class="section-title">À lire aussi</h2>
      <div class="grid">
        {related.map((a) => <ArticleCard article={a} />)}
      </div>
    </nav>
  )}
</Base>

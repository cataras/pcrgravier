---
import { Image } from 'astro:assets';
import CategoryPill from './CategoryPill.astro';
import { mainCategory, url, type Article } from '../lib/site';

interface Props {
  article: Article;
  /** Grande vignette (deux premiers récits de l'accueil) */
  large?: boolean;
  eager?: boolean;
}
const { article, large = false, eager = false } = Astro.props;
const { title, cover, categories } = article.data;
const category = await mainCategory(article);
// tailles d'affichage, d'après la grille (3 colonnes, 2 sous 960 px, 1 sous 600 px)
const sizes = large ? '(max-width: 600px) 100vw, 50vw' : '(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw';
---

<article class:list={['card', { large }]} data-categories={categories.map((c) => c.id).join(' ')}>
  {cover && (
    <Image
      src={cover}
      alt=""
      widths={large ? [640, 960, 1400] : [480, 720, 960]}
      sizes={sizes}
      layout="full-width"
      loading={eager ? 'eager' : 'lazy'}
      style={`view-transition-name: cover-${article.id}`}
    />
  )}
  <div class="card-body">
    {category && <CategoryPill category={category} />}
    <h2><a href={url.entry(article.id)}>{title}</a></h2>
  </div>
</article>

---
import { Image } from 'astro:assets';
import { mainCategory, type Article } from '../lib/site';

interface Props {
  article: Article;
  large?: boolean;
  eager?: boolean;
}
const { article, large = false, eager = false } = Astro.props;
const { title, cover } = article.data;
const category = await mainCategory(article);
---

<article class:list={['card', { large }]}>
  {cover && (
    <Image
      src={cover}
      alt=""
      widths={large ? [640, 960, 1400] : [480, 720, 960]}
      sizes={large ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, 33vw'}
      layout="full-width"
      loading={eager ? 'eager' : 'lazy'}
      style={`view-transition-name: cover-${article.id}`}
    />
  )}
  <div class="card-body">
    {category && <a class="pill" href={`/category/${category.id}/`}>{category.data.name}</a>}
    <h2><a href={`/${article.id}/`}>{title}</a></h2>
  </div>
</article>
